# Big Data Online Lab Environment Configuration
PORT=5000
FLASK_ENV=development
SECRET_KEY=change-this-in-production-bigdata-2026
JWT_SECRET_KEY=change-this-jwt-key-2026

# Database: SQLite for local dev, PostgreSQL for production
